[Unit]
Description=drone_control — leader_radio_health_reader (leader drone; reads own gc_to_leader hop)
Documentation=file:///root/ros2_ws/src/drone_control/BUILDSPEC.md#4.2
After=network-online.target
Wants=network-online.target
PartOf=drone-control-leader.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ros2_ws
EnvironmentFile=/etc/default/drone-control
Environment=DRONE_ID=drone-01
ExecStart=/usr/local/bin/drone-control-run leader_radio_health_reader
Restart=always
RestartSec=5

[Install]
WantedBy=drone-control-leader.target
