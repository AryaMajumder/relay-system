# /etc/default/drone-control — shared environment for all drone_control services.
# Referenced by every unit via EnvironmentFile=/etc/default/drone-control.
#
# DDS / ROS 2 configuration — MUST be identical across every host in the fleet.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///etc/ros/cyclonedds.xml

# SROS 2 — enabled fleet-wide. Keystore must be provisioned identically on every host.
# Permissive strategy: nodes matching an enclave use encrypted DDS; others fall back
# to unencrypted (this matches the shell/CLI default, so `ros2 topic list` works).
ROS_SECURITY_ENABLE=true
ROS_SECURITY_STRATEGY=Enforce
ROS_SECURITY_KEYSTORE=/root/sros2/keystore
