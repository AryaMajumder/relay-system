[Unit]
Description=drone_control — continuous_monitor (follower; SNR fast-path -> reeval_trigger)
Documentation=file:///root/ros2_ws/src/drone_control/BUILDSPEC.md#4.13
After=network-online.target drone-control-capability-assessor.service
Wants=network-online.target
PartOf=drone-control-follower.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ros2_ws
EnvironmentFile=/etc/default/drone-control
Environment=DRONE_ID=drone-02
ExecStart=/usr/local/bin/drone-control-run continuous_monitor
Restart=always
RestartSec=5

[Install]
WantedBy=drone-control-follower.target
