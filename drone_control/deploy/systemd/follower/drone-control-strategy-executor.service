[Unit]
Description=drone_control — strategy_executor (follower; maps strategy -> current_role)
Documentation=file:///root/ros2_ws/src/drone_control/BUILDSPEC.md#4.8
After=network-online.target drone-control-capability-assessor.service
Wants=network-online.target
PartOf=drone-control-follower.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ros2_ws
EnvironmentFile=/etc/default/drone-control
Environment=DRONE_ID=drone-02
ExecStart=/usr/local/bin/drone-control-run strategy_executor
Restart=always
RestartSec=5

[Install]
WantedBy=drone-control-follower.target
