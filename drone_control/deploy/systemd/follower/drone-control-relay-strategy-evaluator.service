[Unit]
Description=drone_control — relay_strategy_evaluator (follower; scores strategy proposals)
Documentation=file:///root/ros2_ws/src/drone_control/BUILDSPEC.md
After=network-online.target drone-control-capability-assessor.service
Wants=network-online.target
PartOf=drone-control-follower.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ros2_ws
EnvironmentFile=/etc/default/drone-control
Environment=DRONE_ID=drone-02
Environment=LEADER_ID=drone-01
ExecStart=/usr/local/bin/drone-control-run relay_strategy_evaluator
Restart=always
RestartSec=5

[Install]
WantedBy=drone-control-follower.target
