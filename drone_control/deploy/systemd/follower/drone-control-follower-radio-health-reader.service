[Unit]
Description=drone_control — follower_radio_health_reader (follower drone; own hop severities)
Documentation=file:///root/ros2_ws/src/drone_control/BUILDSPEC.md#4.2
After=network-online.target
Wants=network-online.target
PartOf=drone-control-follower.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ros2_ws
EnvironmentFile=/etc/default/drone-control
Environment=DRONE_ID=drone-02
ExecStart=/usr/local/bin/drone-control-run follower_radio_health_reader
Restart=always
RestartSec=5

[Install]
WantedBy=drone-control-follower.target
