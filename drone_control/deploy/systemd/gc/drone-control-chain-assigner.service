[Unit]
Description=drone_control — chain_assigner (GC; converts authorization -> relay_assignment)
Documentation=file:///root/ros2_ws/src/drone_control/BUILDSPEC.md
After=network-online.target drone-control-relay-decision-authority.service
Wants=network-online.target
PartOf=drone-control-gc.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/ros2_ws
EnvironmentFile=/etc/default/drone-control
Environment=LEADER_ID=drone-01
Environment=FOLLOWER_IDS=drone-02
ExecStart=/usr/local/bin/drone-control-run chain_assigner
Restart=always
RestartSec=5

[Install]
WantedBy=drone-control-gc.target
