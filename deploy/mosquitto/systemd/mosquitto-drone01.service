[Unit]
Description=Mosquitto MQTT Broker — drone-01 (port 1884)
After=network.target mqtt-ssh-tunnel.service
Wants=network-online.target

[Service]
Type=simple
User=mosquitto
Group=mosquitto
ExecStart=/usr/sbin/mosquitto -c /etc/mosquitto/mosquitto-drone01.conf
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
